# =========================================================================
# S&R CoreSync Solutions - Production Payment & Mail Environment Variables
# Copy this file to .env and insert your real production credentials
# =========================================================================

NODE_ENV=production
GATEWAY_ENVIRONMENT=sandbox # Change to 'production' for live payments

# -------------------------------------------------------------------------
# 1. MOLLIE (Dutch iDEAL, SEPA Bank Transfer, Bancontact)
# Dashboard: https://www.mollie.com/dashboard/developers/api-keys
# -------------------------------------------------------------------------
MOLLIE_API_KEY=live_your_real_mollie_api_key_here
MOLLIE_WEBHOOK_URL=https://dananajmah.com/api/webhooks/mollie
MOLLIE_REDIRECT_URL=https://dananajmah.com/preview-checkout.html?status=paid

# -------------------------------------------------------------------------
# 2. STRIPE (Global Cards, Apple Pay, Google Pay, SEPA Direct Debit)
# Dashboard: https://dashboard.stripe.com/apikeys
# -------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_live_your_real_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_real_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_real_webhook_signing_secret
STRIPE_WEBHOOK_URL=https://dananajmah.com/api/webhooks/stripe

# -------------------------------------------------------------------------
# 3. CLOUD EMAIL & SMTP (Instant BTW Invoice & License Key Dispatch)
# Supported Providers: SendGrid, Postmark, AWS SES, or custom SMTP
# -------------------------------------------------------------------------
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_real_sendgrid_api_key_here
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here

# Direct SMTP Configuration (Google Workspace / Microsoft 365 / cPanel Mail)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
EMAIL_FROM=billing@coresync.solutions
EMAIL_FROM_NAME="S&R CoreSync Solutions - Automated Billing"
EMAIL_BCC=msali@syrian-nl.org
