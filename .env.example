# =========================================================================
# S&R CoreSync Solutions - Production Payment & Mail Environment Variables
# Copy this file to .env and insert your real production credentials
# =========================================================================

NODE_ENV=production
GATEWAY_ENVIRONMENT=sandbox # Change to 'production' for live payments

# -------------------------------------------------------------------------
# 1. MOLLIE (Dutch iDEAL, SEPA Bank Transfer, Bancontact)
# Dashboard: https://www.mollie.com/dashboard/developers/api-keys
# -------------------------------------------------------------------------
MOLLIE_API_KEY=live_your_real_mollie_api_key_here
MOLLIE_WEBHOOK_URL=https://sr-coresync.com/api/webhooks/mollie
MOLLIE_REDIRECT_URL=https://sr-coresync.com/preview-checkout.html?status=paid

# -------------------------------------------------------------------------
# 2. STRIPE (Global Cards, Apple Pay, Google Pay, SEPA Direct Debit)
# Dashboard: https://dashboard.stripe.com/apikeys
# -------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_live_your_real_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_real_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_real_webhook_signing_secret
STRIPE_WEBHOOK_URL=https://sr-coresync.com/api/webhooks/stripe

# -------------------------------------------------------------------------
# 3. OFFICIAL BUSINESS EMAIL & SMTP (Hostinger Mail / SendGrid / Postmark)
# Hostinger Webmail: https://mail.hostinger.com
# Official Accounts: billing@sr-coresync.com | info@sr-coresync.com | salim@sr-coresync.com
# -------------------------------------------------------------------------
EMAIL_PROVIDER=smtp # Options: 'smtp' (Hostinger Mail), 'sendgrid', 'postmark'

# Hostinger Business Email SMTP Parameters
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=billing@sr-coresync.com
SMTP_PASS=your_hostinger_email_password_here

# Outgoing Email Identities
EMAIL_FROM=billing@sr-coresync.com
EMAIL_FROM_NAME="S&R CoreSync Solutions - Automated Billing"
EMAIL_SUPPORT=info@sr-coresync.com
EMAIL_ADMIN=salim@sr-coresync.com
EMAIL_BCC=salim@sr-coresync.com

# Optional Cloud Providers
SENDGRID_API_KEY=SG.your_real_sendgrid_api_key_here
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here


# -------------------------------------------------------------------------
# 5. CRM & AUTOMATION WEBHOOKS (Make.com / Google Sheets / n8n / Zapier)
# -------------------------------------------------------------------------
LEAD_WEBHOOK_URL=https://hook.eu1.make.com/your_make_webhook_token_here
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_google_apps_script_id/exec
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/sr-coresync-leads
