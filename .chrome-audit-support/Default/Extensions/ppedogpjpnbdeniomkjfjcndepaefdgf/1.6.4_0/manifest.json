{
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   }, {
      "all_frames": true,
      "js": [ "print-interceptor.js" ],
      "match_about_blank": true,
      "matches": [ "*://outlook.live.com/*", "*://outlook.office.com/*", "*://outlook.office365.com/*", "*://outlook.cloud.microsoft/*", "*://mail.yahoo.com/print/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "description": "Transform the way you print with HP AI for printing emails and webpages, the ultimate tool for seamless and efficient printing.",
   "host_permissions": [ "*://*/*" ],
   "icons": {
      "128": "public/icons/128x128.png",
      "16": "public/icons/16x16.png",
      "32": "public/icons/32x32.png",
      "48": "public/icons/48x48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "HP AI for Print",
   "permissions": [ "nativeMessaging" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.6.4"
}
