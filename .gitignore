# Temporary scripts and scratch files
scratch/
__pycache__/
*.pyc
.zwork/

# IDE & Editor files
.vscode/
.idea/
.DS_Store

# Environment variables & secrets (Strictly ignored)
# [P2] ملاحظة الإصلاح: أُزيلت الاستثناءات السابقة (!.env.vault) التي كانت
# تبيّض خزنة أسرار الإنتاج للإيداع في المستودع. لا تُعاد أبداً.
.env
.env.local
.env.*.local
.env.vault
!.env.example

# ---------------------------------------------------------------------------
# [P2/P3] Runtime artifacts — never commit (added by security remediation P0-4)
# These files were previously committed to Git history (see
# scripts/git_history_purge.sh for the one-time history scrub).
# ---------------------------------------------------------------------------
# Session & knowledge databases (contain real conversations and indexed docs)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Server / agent runtime logs
*.log
# Chat transcript dumps
chat_history.txt
# User-uploaded attachments fed into the RAG engine
uploads/
# Local API key store for the sovereign auth layer (plaintext keys never live here;
# the file itself holds SHA-256 hashes but must stay off the repository anyway)
auth_keys.json

# Local API tokens & Vault master keys (Purelymail, HSM etc.) — never commit these
.secrets/
*.key
*.pem


# ---------------------------------------------------------------------------
# Build artifacts (regenerable - never commit binaries)
# The production archive is 27 MB; committing it on every build bloated the
# repository to 770 MB and pushed GitHub towards its 1 GB hard warning.
# Regenerate with: node scripts/package_deployment.js
# ---------------------------------------------------------------------------
dist/*.zip
dist/staging/
dist/emails/
dist/lighthouse-audit*.json
dist/lighthouse-audit*.html
dist/lighthouse-*.json
dist/lighthouse-audit-final.report.json

# ---------------------------------------------------------------------------
# Cloudflare Worker (see workers/sr-lead-capture/README.md)
# ---------------------------------------------------------------------------
workers/**/node_modules/
workers/**/.dev.vars
workers/**/.wrangler/
workers/**/tail*.out*

# Local publish staging directory used by the GitHub Pages workflow
_site/

.chrome-audit*
