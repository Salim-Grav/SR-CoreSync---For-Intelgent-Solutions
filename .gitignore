# Temporary scripts and scratch files
scratch/
__pycache__/
*.pyc
.zwork/

# IDE & Editor files
.vscode/
.idea/
.DS_Store

# Environment variables & secrets (Strictly ignored)
.env
.env.local
.env.*.local
!.env.vault
!.env.example

# Local API tokens & Vault master keys (Purelymail, HSM etc.) — never commit these
.secrets/
*.key
*.pem


# ---------------------------------------------------------------------------
# Build artifacts (regenerable - never commit binaries)
# The production archive is 27 MB; committing it on every build bloated the
# repository to 770 MB and pushed GitHub towards its 1 GB hard warning.
# Regenerate with: node scripts/package_deployment.js
# ---------------------------------------------------------------------------
dist/*.zip
dist/staging/
dist/emails/
dist/lighthouse-audit*.json
dist/lighthouse-audit*.html
dist/lighthouse-*.json
dist/lighthouse-audit-final.report.json

# ---------------------------------------------------------------------------
# Cloudflare Worker (see workers/sr-lead-capture/README.md)
# ---------------------------------------------------------------------------
workers/**/node_modules/
workers/**/.dev.vars
workers/**/.wrangler/
workers/**/tail*.out*

# Local publish staging directory used by the GitHub Pages workflow
_site/
