<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mozilla Autoconfiguration for sr-coresync.com
  ---------------------------------------------------------------
  Served from our own domain so the certificate on the connection matches the
  name the client asked for. The CNAME to autoconfig.purelymail.com does not:
  a CNAME keeps the queried hostname for TLS, and Purelymail's certificate only
  covers *.purelymail.com, so a verifying client rejects it.

  Used by Thunderbird and other clients that implement
  https://<domain>/.well-known/autoconfig/mail/config-v1.1.xml
-->
<clientConfig version="1.1">
  <emailProvider id="sr-coresync.com">
    <domain>sr-coresync.com</domain>
    <displayName>S&amp;R CoreSync For Intelligent Solutions</displayName>
    <displayShortName>CoreSync</displayShortName>

    <incomingServer type="imap">
      <hostname>imap.purelymail.com</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>

    <incomingServer type="pop3">
      <hostname>pop3.purelymail.com</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>

    <outgoingServer type="smtp">
      <hostname>smtp.purelymail.com</hostname>
      <port>587</port>
      <socketType>STARTTLS</socketType>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>

    <documentation url="https://sr-coresync.com/status.html">
      <descr lang="ar">حالة منصة S&amp;R CoreSync For Intelligent Solutions</descr>
      <descr lang="en">S&amp;R CoreSync For Intelligent Solutions platform status</descr>
    </documentation>
  </emailProvider>

  <webMail>
    <loginPage url="https://inbox.purelymail.com/" />
    <loginPageInfo url="https://inbox.purelymail.com/">
      <username>%EMAILADDRESS%</username>
      <usernameField>_user</usernameField>
      <passwordField>_pass</passwordField>
      <loginButton>_rcmloginsubmit</loginButton>
    </loginPageInfo>
  </webMail>
</clientConfig>
